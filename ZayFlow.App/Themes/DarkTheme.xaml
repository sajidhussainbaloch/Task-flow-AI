<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════ -->
    <!--              DARK THEME COLORS              -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Background hierarchy -->
    <Color x:Key="WindowBackgroundColor">#0F0F14</Color>
    <Color x:Key="SidebarBackgroundColor">#16161E</Color>
    <Color x:Key="CardBackgroundColor">#1C1C28</Color>
    <Color x:Key="CardHoverBackgroundColor">#22222E</Color>
    <Color x:Key="SurfaceColor">#252533</Color>
    <Color x:Key="OverlayColor">#0A0A0F</Color>

    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#B4B4C6</Color>
    <Color x:Key="TertiaryTextColor">#7C7C8E</Color>
    <Color x:Key="PlaceholderTextColor">#5A5A6C</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#2A2A3A</Color>
    <Color x:Key="BorderHoverColor">#3A3A4E</Color>
    <Color x:Key="DividerColor">#1E1E2C</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#6366F1</Color>
    <Color x:Key="AccentHoverColor">#7C7FF7</Color>
    <Color x:Key="AccentPressedColor">#5558E0</Color>
    <Color x:Key="AccentSubtleColor">#1E1E3A</Color>

    <!-- Status colors -->
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="SuccessSubtleColor">#0D2E23</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="WarningSubtleColor">#2E2508</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="ErrorSubtleColor">#2E0D0D</Color>
    <Color x:Key="InfoColor">#60A5FA</Color>
    <Color x:Key="InfoSubtleColor">#0D1A2E</Color>

    <!-- Sidebar -->
    <Color x:Key="SidebarItemHoverColor">#22222E</Color>
    <Color x:Key="SidebarItemActiveColor">#1E1E3A</Color>
    <Color x:Key="SidebarItemActiveTextColor">#A5B4FC</Color>

    <!-- Input -->
    <Color x:Key="InputBackgroundColor">#1C1C28</Color>
    <Color x:Key="InputBorderColor">#2A2A3A</Color>
    <Color x:Key="InputFocusBorderColor">#6366F1</Color>

    <!-- Scrollbar -->
    <Color x:Key="ScrollbarTrackColor">#16161E</Color>
    <Color x:Key="ScrollbarThumbColor">#2A2A3A</Color>
    <Color x:Key="ScrollbarThumbHoverColor">#3A3A4E</Color>

    <!-- Icons/Emojis -->
    <Color x:Key="IconPrimaryColor">#F0F0F5</Color>
    <Color x:Key="IconSecondaryColor">#9898AA</Color>

    <!-- ══════════ BRUSHES ══════════ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="{StaticResource CardHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}"/>
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="{StaticResource PlaceholderTextColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{StaticResource ErrorSubtleColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="{StaticResource InfoSubtleColor}"/>

    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{StaticResource SidebarItemHoverColor}"/>
    <SolidColorBrush x:Key="SidebarItemActiveBrush" Color="{StaticResource SidebarItemActiveColor}"/>
    <SolidColorBrush x:Key="SidebarItemActiveTextBrush" Color="{StaticResource SidebarItemActiveTextColor}"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorderColor}"/>

    <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="{StaticResource ScrollbarTrackColor}"/>
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource ScrollbarThumbColor}"/>
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{StaticResource ScrollbarThumbHoverColor}"/>

    <SolidColorBrush x:Key="IconPrimaryBrush" Color="{StaticResource IconPrimaryColor}"/>
    <SolidColorBrush x:Key="IconSecondaryBrush" Color="{StaticResource IconSecondaryColor}"/>

    <!-- Accent Gradient (3-stop premium) -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#818CF8" Offset="0.5"/>
        <GradientStop Color="#A78BFA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UserBubbleGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#818CF8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#2E0D0D"/>

    <!-- ══════════ GLASS MATERIAL SYSTEM ══════════ -->

    <!-- Glass card fill — semi-transparent for depth -->
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#1C1C28" Opacity="0.78"/>
    <!-- Glass card border — subtle white catch-light -->
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#FFFFFF" Opacity="0.08"/>
    <!-- Glass highlight — top-edge light refraction line -->
    <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Sidebar glass — slightly more opaque for readability -->
    <SolidColorBrush x:Key="SidebarGlassBrush" Color="#16161E" Opacity="0.78"/>
    <!-- Title bar glass -->
    <SolidColorBrush x:Key="TitleBarGlassBrush" Color="#12121A" Opacity="0.82"/>
    <SolidColorBrush x:Key="ChatGlassBrush" Color="#1A1A26" Opacity="0.55"/>
    <!-- Ambient glow orb — decorative background accent -->
    <RadialGradientBrush x:Key="AmbientGlowBrush" Center="0.3,0.2" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#146366F1" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <!-- Secondary ambient glow (warm) -->
    <RadialGradientBrush x:Key="AmbientGlowWarmBrush" Center="0.8,0.8" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#0A8B5CF6" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <!-- Glass hover glow border -->
    <SolidColorBrush x:Key="GlassHoverBorderBrush" Color="#6366F1" Opacity="0.25"/>
    <!-- Premium gradient brushes -->
    <LinearGradientBrush x:Key="PremiumGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#EC4899" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#34D399" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WarmGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F97316" Offset="0"/>
        <GradientStop Color="#F59E0B" Offset="1"/>
    </LinearGradientBrush>
    <!-- Gradient divider line (fade in/out) -->
    <LinearGradientBrush x:Key="GradientDividerBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#002A2A3A" Offset="0"/>
        <GradientStop Color="#FF2A2A3A" Offset="0.5"/>
        <GradientStop Color="#002A2A3A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Input focus glow -->
    <SolidColorBrush x:Key="InputFocusGlowBrush" Color="#6366F1" Opacity="0.18"/>
    <SolidColorBrush x:Key="ChatBubbleHoverBrush" Color="#FFFFFF" Opacity="0.04"/>
    <SolidColorBrush x:Key="WelcomeShimmerBrush" Color="#6366F1" Opacity="0.06"/>

    <!-- Title bar -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#12121A"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#2A2A3A"/>
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#E81123"/>

</ResourceDictionary>
