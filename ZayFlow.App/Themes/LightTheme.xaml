<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════ -->
    <!--             LIGHT THEME COLORS              -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Background hierarchy -->
    <Color x:Key="WindowBackgroundColor">#FAFBFC</Color>
    <Color x:Key="SidebarBackgroundColor">#F3F4F6</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="CardHoverBackgroundColor">#F9FAFB</Color>
    <Color x:Key="SurfaceColor">#F0F1F3</Color>
    <Color x:Key="OverlayColor">#FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#000000</Color>
    <Color x:Key="SecondaryTextColor">#4B5563</Color>
    <Color x:Key="TertiaryTextColor">#6B7280</Color>
    <Color x:Key="PlaceholderTextColor">#9CA3AF</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="BorderHoverColor">#D1D5DB</Color>
    <Color x:Key="DividerColor">#F3F4F6</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#6366F1</Color>
    <Color x:Key="AccentHoverColor">#5558E0</Color>
    <Color x:Key="AccentPressedColor">#4F46E5</Color>
    <Color x:Key="AccentSubtleColor">#EEF2FF</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessSubtleColor">#ECFDF5</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSubtleColor">#FFFBEB</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorSubtleColor">#FEF2F2</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="InfoSubtleColor">#EFF6FF</Color>

    <!-- Sidebar -->
    <Color x:Key="SidebarItemHoverColor">#E5E7EB</Color>
    <Color x:Key="SidebarItemActiveColor">#EEF2FF</Color>
    <Color x:Key="SidebarItemActiveTextColor">#4F46E5</Color>

    <!-- Input -->
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="InputBorderColor">#D1D5DB</Color>
    <Color x:Key="InputFocusBorderColor">#6366F1</Color>

    <!-- Scrollbar -->
    <Color x:Key="ScrollbarTrackColor">#F3F4F6</Color>
    <Color x:Key="ScrollbarThumbColor">#D1D5DB</Color>
    <Color x:Key="ScrollbarThumbHoverColor">#9CA3AF</Color>

    <!-- Icons/Emojis -->
    <Color x:Key="IconPrimaryColor">#111827</Color>
    <Color x:Key="IconSecondaryColor">#6B7280</Color>

    <!-- ══════════ BRUSHES ══════════ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="{StaticResource CardHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}"/>
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="{StaticResource PlaceholderTextColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{StaticResource ErrorSubtleColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="{StaticResource InfoSubtleColor}"/>

    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{StaticResource SidebarItemHoverColor}"/>
    <SolidColorBrush x:Key="SidebarItemActiveBrush" Color="{StaticResource SidebarItemActiveColor}"/>
    <SolidColorBrush x:Key="SidebarItemActiveTextBrush" Color="{StaticResource SidebarItemActiveTextColor}"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorderColor}"/>

    <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="{StaticResource ScrollbarTrackColor}"/>
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource ScrollbarThumbColor}"/>
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{StaticResource ScrollbarThumbHoverColor}"/>

    <SolidColorBrush x:Key="IconPrimaryBrush" Color="{StaticResource IconPrimaryColor}"/>
    <SolidColorBrush x:Key="IconSecondaryBrush" Color="{StaticResource IconSecondaryColor}"/>

    <!-- Accent Gradient (3-stop premium) -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#818CF8" Offset="0.5"/>
        <GradientStop Color="#A78BFA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UserBubbleGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#818CF8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FEF2F2"/>

    <!-- ══════════ GLASS MATERIAL SYSTEM ══════════ -->

    <!-- Glass card fill — semi-transparent frosted white -->
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#FFFFFF" Opacity="0.70"/>
    <!-- Glass card border — subtle dark catch-light -->
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#000000" Opacity="0.06"/>
    <!-- Glass highlight — top-edge light refraction line -->
    <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#20FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Sidebar glass — frosted off-white -->
    <SolidColorBrush x:Key="SidebarGlassBrush" Color="#F3F4F6" Opacity="0.80"/>
    <!-- Title bar glass -->
    <SolidColorBrush x:Key="TitleBarGlassBrush" Color="#F0F1F3" Opacity="0.85"/>
    <!-- Ambient glow orb — decorative background accent -->
    <RadialGradientBrush x:Key="AmbientGlowBrush" Center="0.3,0.2" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#0C6366F1" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <!-- Secondary ambient glow (warm) -->
    <RadialGradientBrush x:Key="AmbientGlowWarmBrush" Center="0.8,0.8" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#088B5CF6" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <!-- Glass hover glow border -->
    <SolidColorBrush x:Key="GlassHoverBorderBrush" Color="#6366F1" Opacity="0.20"/>
    <!-- Premium gradient brushes -->
    <LinearGradientBrush x:Key="PremiumGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#EC4899" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#34D399" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WarmGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F97316" Offset="0"/>
        <GradientStop Color="#F59E0B" Offset="1"/>
    </LinearGradientBrush>
    <!-- Gradient divider line (fade in/out) -->
    <LinearGradientBrush x:Key="GradientDividerBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00E5E7EB" Offset="0"/>
        <GradientStop Color="#FFE5E7EB" Offset="0.5"/>
        <GradientStop Color="#00E5E7EB" Offset="1"/>
    </LinearGradientBrush>

    <!-- Title bar -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F0F1F3"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#E81123"/>

</ResourceDictionary>
