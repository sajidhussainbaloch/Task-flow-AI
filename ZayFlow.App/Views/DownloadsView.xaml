<UserControl x:Class="ZayFlow.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ZayFlow.App.Converters"
             xmlns:services="clr-namespace:ZayFlow.App.Services">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:BoolToCollapsedConverter x:Key="BoolCollapse"/>

        <!-- Download status to progress bar color -->
        <Style x:Key="DownloadProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGradientBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{TemplateBinding Foreground}"/>
                            <Border x:Name="PART_Track"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button style -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.06" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.06" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PremiumScrollViewer}" Padding="{StaticResource PagePadding}">
        <StackPanel>

            <!-- ═══ Header ═══ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Downloads" Style="{StaticResource HeadingXL}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource BodyText}">
                        <Run Text="Manage your file downloads — pause, resume, or cancel anytime"/>
                    </TextBlock>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel All" Padding="14,8"
                            Command="{Binding CancelAllCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Clear Finished" Padding="14,8"
                            Command="{Binding ClearFinishedCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ═══ Stats Bar ═══ -->
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,20" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Active" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActiveCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Completed -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Completed" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CompletedCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Total -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Total" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Empty State ═══ -->
            <Border Style="{StaticResource PremiumCard}" Padding="40,60" Margin="0,0,0,20"
                    Visibility="{Binding HasNoDownloads, Converter={StaticResource BoolVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⬇" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,16"
                               Foreground="{DynamicResource AccentBrush}" Opacity="0.95"/>
                    <TextBlock Text="No downloads yet" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Ask ZayFlow AI to download something, and it will appear here."
                               FontSize="13" Foreground="{DynamicResource TertiaryTextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ═══ Download List ═══ -->
            <ItemsControl ItemsSource="{Binding Downloads}"
                          Visibility="{Binding HasDownloads, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type services:DownloadItem}">
                        <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,10" Padding="18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 1: File name + status + actions -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status icon -->
                                    <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="20"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- File name + URL -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Url}" FontSize="11"
                                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="500"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Speed / status text -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="12,0">
                                        <TextBlock Text="{Binding SpeedText}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <!-- Pause (visible when downloading) -->
                                        <Button Style="{StaticResource IconBtn}" Content="⏸️"
                                                ToolTip="Pause download"
                                                Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanPause}"/>

                                        <!-- Resume (visible when paused) -->
                                        <Button Style="{StaticResource IconBtn}" Content="▶️"
                                                ToolTip="Resume download"
                                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanResume}"/>

                                        <!-- Cancel -->
                                        <Button Style="{StaticResource IconBtn}" Content="⏹️"
                                                ToolTip="Cancel download"
                                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanCancel}"/>

                                        <!-- Open folder (visible when completed) -->
                                        <Button Style="{StaticResource IconBtn}" Content="{StaticResource IconFolder}" FontFamily="{StaticResource IconFont}"
                                                ToolTip="Open folder"
                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>

                                        <!-- Remove from list -->
                                        <Button Style="{StaticResource IconBtn}" Content="{StaticResource IconTrash}" FontFamily="{StaticResource IconFont}"
                                                ToolTip="Remove from list"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Progress bar -->
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <ProgressBar Style="{StaticResource DownloadProgressBar}"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 Minimum="0" Maximum="100"/>
                                </Grid>

                                <!-- Row 3: Size info + time -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="11"
                                               Foreground="{DynamicResource TertiaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="11"
                                               Foreground="{DynamicResource TertiaryTextBrush}">
                                        <Run Text="Started: "/>
                                        <Run Text="{Binding StartedAtText, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
