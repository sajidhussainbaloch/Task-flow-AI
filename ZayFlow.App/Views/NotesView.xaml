<UserControl x:Class="ZayFlow.App.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="24,24,24,0">
            <TextBlock Text="Notes" Style="{StaticResource HeadingXL}" Margin="0,0,0,6"/>
            <TextBlock Text="Capture ideas, rewrite with AI, and organize your thoughts." Style="{StaticResource BodyText}" Margin="0,0,0,16"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Notes Sidebar -->
            <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Margin="0,0,16,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource PrimaryButton}" Content="+ New Note" Command="{Binding CreateNoteCommand}"/>
                    <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}"
                             Style="{StaticResource PremiumListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Background="Transparent" CornerRadius="8" Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Folder}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TertiaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Note Editor -->
            <Border Grid.Column="1" Style="{StaticResource PremiumCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title + Folder -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource PremiumTextBox}" Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Note title"/>
                        <TextBox Grid.Column="1" Width="160" Margin="10,0,0,0" Style="{StaticResource PremiumTextBox}"
                                 Text="{Binding SelectedNote.Folder, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Folder / Category"/>
                    </Grid>

                    <!-- Content -->
                    <TextBox Grid.Row="1" Style="{StaticResource PremiumTextBox}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedNote.Content, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- AI Actions -->
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveNoteCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Rewrite" Command="{Binding RewriteCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Summarize" Command="{Binding SummarizeCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Expand Ideas" Command="{Binding ExpandIdeasCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Convert to Tasks" Command="{Binding ConvertToTasksCommand}"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
