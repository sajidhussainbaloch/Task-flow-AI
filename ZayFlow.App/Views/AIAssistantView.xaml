<UserControl x:Class="ZayFlow.App.Views.AIAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZayFlow.App.Controls"
             xmlns:converters="clr-namespace:ZayFlow.App.Converters"
             AllowDrop="True"
             PreviewKeyDown="Root_PreviewKeyDown"
             DragEnter="Root_DragEnter"
             Drop="Root_Drop">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
        <converters:NonNegativeConverter x:Key="NonNegativeConverter"/>
        <converters:ProgressWidthConverter x:Key="ProgressWidthConverter"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CHAT AREA — Clean, no border -->
        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0"
                      Style="{StaticResource PremiumScrollViewer}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,12">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <StackPanel x:Name="ChatContainer" MaxWidth="820" HorizontalAlignment="Center" Margin="32,24,32,8"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </StackPanel.RenderTransform>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowWelcome}" Value="True">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowWelcome}" Value="False">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="-36" To="0" Duration="0:0:0.34">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                <!-- Welcome Card -->
                <Border Margin="0,0,0,20" Padding="28,24" Style="{StaticResource GlassCard}"
                    Visibility="{Binding ShowWelcome, Converter={StaticResource BoolVis}}"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.97" To="1" Duration="0:0:0.35">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.97" To="1" Duration="0:0:0.35">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="42" Height="42" CornerRadius="12"
                                    Background="{DynamicResource AccentGradientBrush}" Margin="0,0,14,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                                <TextBlock Text="Z" FontSize="19" FontWeight="Bold" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserGreeting}" Style="{StaticResource HeadingLG}"/>
                                <TextBlock Text="Your intelligent coding partner. Ask me anything."
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Margin="0,12,0,0" Visibility="{Binding ShowActionCards, Converter={StaticResource BoolVis}}">
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,9"
                                    Content="&#xE943;  Write a function" FontFamily="{StaticResource IconFont}"
                                    Command="{Binding ActionCardCommand}" CommandParameter="Help me write a clean, well-structured function"/>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,9"
                                    Content="&#xE8B9;  Analyze an image" FontFamily="{StaticResource IconFont}"
                                    Command="{Binding ActionCardCommand}" CommandParameter="Paste a screenshot and I'll analyze it for you"/>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,9"
                                    Content="&#xE8B7;  Tidy my files" FontFamily="{StaticResource IconFont}"
                                    Command="{Binding ActionCardCommand}" CommandParameter="Organize my downloads folder by file type"/>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,9"
                                    Content="&#xE70F;  Review my code" FontFamily="{StaticResource IconFont}"
                                    Command="{Binding ActionCardCommand}" CommandParameter="Review this code and suggest improvements"/>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,0,8" Padding="10,8"
                                    Content="Dismiss" Command="{Binding DismissActionCardsCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Messages -->
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6" RenderTransformOrigin="0.5,0.5">
                                <!-- Fade-in + slide-up animation -->
                                <Grid.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </Grid.RenderTransform>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="16" To="0" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <Border Padding="16,12" MaxWidth="680" Margin="0,0,0,4"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="CornerRadius" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource UserBubbleGradientBrush}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="CornerRadius" Value="18,18,4,18"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.15"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource ChatGlassBrush}"/>
                                                    <Setter Property="CornerRadius" Value="4,18,18,18"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- User text -->
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" LineHeight="22">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- AI response with markdown -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Width="26" Height="26" CornerRadius="7"
                                                        Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0">
                                                    <TextBlock Text="Z" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="ZayFlow" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TimeText}" FontSize="11" Margin="10,0,0,0"
                                                           Foreground="{DynamicResource TertiaryTextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <controls:MarkdownViewer MarkdownText="{Binding Content}" Margin="0,0,0,0"/>

                                            <Border Margin="0,10,0,0" Padding="10,8"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="10"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Visibility="{Binding HasCodeSession, Converter={StaticResource BoolVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="Code Session" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding CodeSession.SummaryText}" Margin="0,4,0,0"
                                                               TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding CodeSession.VerificationSummary}" Margin="0,2,0,0"
                                                               TextWrapping="Wrap" FontSize="11"
                                                               Foreground="{DynamicResource TertiaryTextBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Inline code artifacts -->
                                            <ItemsControl ItemsSource="{Binding Artifacts}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,4,0,4" CornerRadius="10"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1">
                                                            <StackPanel>
                                                                <!-- Modern header bar -->
                                                                <Border Padding="12,8" CornerRadius="10,10,0,0"
                                                                        Background="{DynamicResource CardBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                                    <DockPanel>
                                                                        <!-- Left: file icon + title -->
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <!-- Right: language badge + copy button -->
                                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                            <!-- Language badge -->
                                                                            <Border CornerRadius="4" Padding="8,2" Margin="0,0,8,0"
                                                                                    Background="{DynamicResource AccentSubtleBrush}">
                                                                                <TextBlock Text="{Binding Language}" FontSize="10.5" FontWeight="Medium"
                                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <!-- Copy button with hover effect -->
                                                                            <Button ToolTip="Copy code to clipboard"
                                                                                    Command="{Binding DataContext.CopyArtifactCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Content}"
                                                                                    Cursor="Hand" Padding="6,4">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="CopyBorder" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                                                                Background="Transparent">
                                                                                            <StackPanel Orientation="Horizontal">
                                                                                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                                                                           Foreground="{DynamicResource TertiaryTextBrush}" VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="Copy" FontSize="11" Margin="4,0,0,0"
                                                                                                           Foreground="{DynamicResource TertiaryTextBrush}" VerticalAlignment="Center"/>
                                                                                            </StackPanel>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="CopyBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Border>
                                                                <!-- Code viewer with max height and smooth scrolling -->
                                                                <controls:CodeArtifactViewer CodeText="{Binding Content}" Language="{Binding Language}" MaxHeight="500"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding ToolTraceSummary}" Margin="0,6,0,0" FontSize="11.5"
                                                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Attachments -->
                                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6" Padding="10,8"
                                                            Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="32" Height="32" CornerRadius="6"
                                                                    Background="{DynamicResource AccentSubtleBrush}" Margin="0,0,10,0">
                                                                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                <TextBlock Text="{Binding PreviewText}" FontSize="11"
                                                                           Foreground="{DynamicResource TertiaryTextBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Live progress indicator -->
                <Border Padding="16,14" Margin="0,4,0,0" CornerRadius="4,18,18,18"
                        Background="{DynamicResource ChatGlassBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        MaxWidth="680" HorizontalAlignment="Left"
                        Visibility="{Binding IsTyping, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <!-- Header row: icon + status text + pulsing dots -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding TypingStageIcon, FallbackValue=⚡}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding TypingStatusText, FallbackValue=Generating response...}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,0,3,0">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.45" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,0,3,0">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.15">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.45" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.3">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.45" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </StackPanel>
                        </StackPanel>

                        <!-- Animated progress bar (only visible when TypingProgress >= 0) -->
                        <Grid Margin="0,10,0,0" Height="4">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TypingProgress, Converter={StaticResource NonNegativeConverter}, FallbackValue=False}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <!-- Track -->
                            <Border CornerRadius="2" Background="{DynamicResource SurfaceBrush}" Opacity="0.5"/>
                            <!-- Fill bar -->
                            <Border CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentGradientBrush}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                        <Binding Path="TypingProgress"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                    </MultiBinding>
                                </Border.Width>
                                <!-- Shimmer glow animation -->
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.75" To="1" Duration="0:0:0.8" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>

                        <!-- Indeterminate pulsing bar (when no percentage, TypingProgress < 0) -->
                        <Border Margin="0,10,0,0" Height="3" CornerRadius="1.5"
                                Background="{DynamicResource AccentBrush}" Opacity="0.4"
                                RenderTransformOrigin="0,0.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TypingProgress, Converter={StaticResource NonNegativeConverter}, FallbackValue=False}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.3"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="0.15" To="1" Duration="0:0:1.2" AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="0.6" Duration="0:0:1.2" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- INPUT AREA -->
        <Border Grid.Row="1" Padding="0,12,0,0"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource WindowBackgroundBrush}">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#006366F1" Offset="0"/>
                    <GradientStop Color="#336366F1" Offset="0.5"/>
                    <GradientStop Color="#006366F1" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <StackPanel MaxWidth="820" HorizontalAlignment="Center" Margin="32,0,32,20">

                <!-- Confirmation bar -->
                <Border Visibility="{Binding ShowingConfirmation, Converter={StaticResource BoolVis}}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Review before executing" Style="{StaticResource HeadingSM}" Foreground="{DynamicResource WarningBrush}"/>
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,10" MaxHeight="140">
                            <TextBlock Text="{Binding ConfirmationMessage}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12" LineHeight="20"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Confirm" Command="{Binding ExecuteCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Resume card — shown when a resumable checkpoint is found -->
                <Border Visibility="{Binding ShowingResume, Converter={StaticResource BoolVis}}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Resume Previous Workflow" Style="{StaticResource HeadingSM}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding ResumeSummary}" TextWrapping="Wrap"
                                   FontSize="13" LineHeight="20" Margin="0,0,0,10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="Discard" Margin="0,0,8,0"
                                    Command="{Binding DiscardResumeCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="&#xE768;  Continue"
                                    FontFamily="{StaticResource IconFont}"
                                    Command="{Binding ResumeWorkflowCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Plan card — transparent plan execution UI -->
                <Border Visibility="{Binding ShowingPlan, Converter={StaticResource BoolVis}}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: title + risk badge -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding PlanTitle}" Style="{StaticResource HeadingSM}"
                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    CornerRadius="8" Padding="8,3"
                                    Background="{DynamicResource SurfaceBrush}">
                                <TextBlock Text="{Binding PlanOverallRisk}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                        </DockPanel>

                        <!-- Summary -->
                        <TextBlock Grid.Row="1" Text="{Binding PlanSummary}" TextWrapping="Wrap"
                                   FontSize="13" LineHeight="20" Margin="0,0,0,10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <!-- Steps list -->
                        <ScrollViewer Grid.Row="2" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding PlanSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="10,7" CornerRadius="8"
                                                Background="{DynamicResource SurfaceBrush}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="14" VerticalAlignment="Center"
                                                           Margin="0,0,8,0" Width="22" TextAlignment="Center"/>
                                                <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                        CornerRadius="6" Padding="6,2"
                                                        Background="{DynamicResource CardBackgroundBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RiskBadge}" FontSize="10"
                                                               Foreground="{DynamicResource TertiaryTextBrush}"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}" FontSize="12.5" FontWeight="Medium"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Target}" FontSize="11"
                                                               Foreground="{DynamicResource TertiaryTextBrush}"
                                                               FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Progress text -->
                        <TextBlock Grid.Row="3" Text="{Binding PlanProgress}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding IsExecutingPlan, Converter={StaticResource BoolVis}}"/>

                        <!-- Action buttons -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Skip Step" Margin="0,0,8,0"
                                    Command="{Binding SkipStepCommand}"
                                    Visibility="{Binding IsExecutingPlan, Converter={StaticResource BoolVis}}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Reject" Margin="0,0,8,0"
                                    Command="{Binding RejectPlanCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="&#xE8FB;  Approve &amp; Execute"
                                    FontFamily="{StaticResource IconFont}"
                                    Command="{Binding ApprovePlanCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pending attachments -->
                <ItemsControl ItemsSource="{Binding PendingAttachments}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,6" Padding="8,6" CornerRadius="10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24" Height="24" CornerRadius="6"
                                            Background="{DynamicResource AccentSubtleBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Button Margin="8,0,0,0" Padding="4,2" Style="{StaticResource GhostButton}"
                                            Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                            Command="{Binding DataContext.RemovePendingAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Input box -->
                <Border x:Name="InputBorder" CornerRadius="16" Padding="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Effect" Value="{x:Null}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=InputBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.22"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="InputBox" Grid.Row="0"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="False" TextWrapping="Wrap"
                                 MinHeight="40" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"
                                 IsEnabled="{Binding IsInputEnabled}"
                                 FontSize="14" Padding="12,10"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                    <TextBlock Text="Type Here"
                                                               IsHitTestVisible="False"
                                                               Foreground="{DynamicResource PlaceholderTextBrush}"
                                                               Padding="12,10" FontSize="14"
                                                               VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <DockPanel Grid.Row="1" Margin="6,0,6,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- "+" menu button -->
                                <ToggleButton x:Name="AttachMenuToggle" Cursor="Hand"
                                              ToolTip="Attach, modes &amp; more"
                                              Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder" Background="Transparent" CornerRadius="8" Padding="7,5" Width="32" Height="32">
                                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- Modernised dropdown popup -->
                                <Popup IsOpen="{Binding IsChecked, ElementName=AttachMenuToggle}" StaysOpen="False"
                                       Placement="Top" PlacementTarget="{Binding ElementName=AttachMenuToggle}"
                                       AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="12" Padding="4,6" MinWidth="190" Margin="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.32"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <!-- Section: Attach -->
                                            <TextBlock Text="ATTACH" FontSize="10" FontWeight="SemiBold" Margin="12,4,0,4"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" Opacity="0.6"/>
                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="10,7"
                                                    Command="{Binding AttachImageFromFileCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ItemBg" Background="Transparent" CornerRadius="8" Padding="10,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="Image" FontSize="13" FontWeight="Medium"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="Ctrl+V" FontSize="10" FontFamily="{StaticResource MonoFont}"
                                                                           Foreground="{DynamicResource TertiaryTextBrush}" Opacity="0.5" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="10,7"
                                                    Command="{Binding AttachFileCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ItemBg" Background="Transparent" CornerRadius="8" Padding="10,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="File" FontSize="13" FontWeight="Medium"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Divider -->
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,6" Opacity="0.4"/>

                                            <!-- Section: Modes -->
                                            <TextBlock Text="MODES" FontSize="10" FontWeight="SemiBold" Margin="12,4,0,4"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" Opacity="0.6"/>
                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding TogglePlanModeCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ItemBg" Background="Transparent" CornerRadius="8" Padding="10,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="Plan Mode" FontSize="13" FontWeight="Medium"
                                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                    <TextBlock Text="Propose → approve → execute" FontSize="10"
                                                                               Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,1,0,0"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                                        Margin="8,0,0,0"
                                                                        Visibility="{Binding IsPlanMode, Converter={StaticResource BoolVis}}">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="#10B981"/>
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Plan mode chip (shown when active, hidden during typing) -->
                                <Border CornerRadius="8" Padding="8,4,6,4" Margin="4,0,0,0"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        VerticalAlignment="Center" Cursor="Hand"
                                        ToolTip="Plan Mode active — click ✕ to disable">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPlanMode}" Value="True"/>
                                                        <Condition Binding="{Binding IsTyping}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Plan" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <Button Command="{Binding TogglePlanModeCommand}" Cursor="Hand"
                                                ToolTip="Disable Plan Mode" Margin="4,0,0,0"
                                                Background="Transparent" BorderThickness="0" Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="XBg" Width="18" Height="18" CornerRadius="9"
                                                            Background="Transparent">
                                                        <TextBlock x:Name="XIcon" Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TertiaryTextBrush}" Opacity="0"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="XBg" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                                                            <Setter TargetName="XIcon" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Padding="8,4" Margin="0,0,10,0"
                                        ToolTip="When ON, ZayFlow automatically executes actions (file creation, commands) without asking for confirmation."
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsAutoMode}"
                                                      VerticalAlignment="Center"/>
                                        <TextBlock Text="Auto" FontSize="10.5" FontWeight="Medium" Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding EstimatedTokens, StringFormat=~{0} tokens}" FontSize="11"
                                           Foreground="{DynamicResource TertiaryTextBrush}" VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <!-- Send button (visible when NOT typing) -->
                                <Border CornerRadius="12" RenderTransformOrigin="0.5,0.5"
                                        Visibility="{Binding IsTyping, Converter={StaticResource InverseBoolVis}}">
                                    <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    <Button Style="{StaticResource PrimaryButton}" Padding="18,8" Command="{Binding SendCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Send" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>

                                <!-- Stop button (visible when typing / generating) -->
                                <Button Command="{Binding CancelCommand}" Cursor="Hand"
                                        ToolTip="Stop generation"
                                        Visibility="{Binding IsTyping, Converter={StaticResource BoolVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="StopBorder" CornerRadius="12" Padding="14,8"
                                                    Background="#E5484D">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#E5484D" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                                                </Border.Effect>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="12" Height="12" CornerRadius="2" Background="White"
                                                            VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="Stop" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="StopBorder" Property="Background" Value="#C33"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="StopBorder" Property="Background" Value="#A22"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Token footer -->
                <DockPanel Margin="4,8,4,0">
                    <TextBlock Text="{Binding UpgradeMessage}" FontSize="11"
                               Foreground="{DynamicResource WarningBrush}"
                               Visibility="{Binding ShowUpgradeMessage, Converter={StaticResource BoolVis}}"/>
                    <TextBlock DockPanel.Dock="Right" FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TertiaryTextBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1} tokens used today">
                                <Binding Path="UsedTokens"/>
                                <Binding Path="DailyTokenLimit"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>
        <!-- Centering/animation handled via ChatContainer style (ShowWelcome) -->
    </Grid>
</UserControl>
