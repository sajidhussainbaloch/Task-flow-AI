<UserControl x:Class="ZayFlow.App.Views.AIAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZayFlow.App.Controls"
             xmlns:converters="clr-namespace:ZayFlow.App.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--          CHAT MESSAGES AREA                 -->
        <!-- ═══════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="0"
                      x:Name="ChatScrollViewer"
                      Style="{StaticResource PremiumScrollViewer}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,20">

                <!-- ══════════════════════════════════ -->
                <!-- HERO WELCOME AREA                  -->
                <!-- ══════════════════════════════════ -->
                <Border Padding="48,36,48,16" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolVis}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="720">

                        <!-- Auto Mode Toggle (top-right) -->
                        <Border HorizontalAlignment="Right" Margin="0,0,0,16"
                                Background="{DynamicResource SurfaceBrush}" CornerRadius="20"
                                Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Auto Mode" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ToggleButton Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding IsAutoMode, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Big Logo -->
                        <Border Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16"
                                CornerRadius="20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="Z" FontSize="44" FontWeight="Bold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="White"/>
                        </Border>

                        <!-- Big Title with Gradient -->
                        <TextBlock Text="ZayFlow AI" FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#A5B4FC" Offset="0.5"/>
                                    <GradientStop Color="#818CF8" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <!-- Dynamic Greeting -->
                        <TextBlock Text="{Binding UserGreeting}"
                                   FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="Manage files, clean your PC, and automate tasks — all with AI."
                                   FontSize="12.5" Foreground="{DynamicResource TertiaryTextBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,28"/>

                        <!-- ══════════════════════════ -->
                        <!-- ACTION CARDS (one-time)    -->
                        <!-- ══════════════════════════ -->
                        <Border Visibility="{Binding ShowActionCards, Converter={StaticResource BoolVis}}"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Q U I C K   A C T I O N S" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <UniformGrid Columns="2" HorizontalAlignment="Center" MaxWidth="560">
                                    <!-- Card: Organize Downloads -->
                                    <Button Command="{Binding ActionCardCommand}"
                                            CommandParameter="Organize my Downloads folder by file type"
                                            Margin="6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CardBd"
                                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="14"
                                                                    Padding="18,16" MinHeight="82">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                        <TextBlock Text="📂" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Organize Downloads" FontSize="14" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="Sort files into Images, Documents, Videos..."
                                                                               FontSize="11.5" Foreground="{DynamicResource TertiaryTextBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Card: Clean My PC -->
                                    <Button Command="{Binding ActionCardCommand}"
                                            CommandParameter="Clean my temp files and free up disk space"
                                            Margin="6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CardBd"
                                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="14"
                                                                    Padding="18,16" MinHeight="82">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                        <TextBlock Text="🧹" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Clean My PC" FontSize="14" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="Remove temp files, caches, and junk data"
                                                                               FontSize="11.5" Foreground="{DynamicResource TertiaryTextBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Card: Find Large Files -->
                                    <Button Command="{Binding ActionCardCommand}"
                                            CommandParameter="Find large files taking up space on my PC"
                                            Margin="6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CardBd"
                                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="14"
                                                                    Padding="18,16" MinHeight="82">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                        <TextBlock Text="🔍" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Find Large Files" FontSize="14" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="Discover what's eating your disk space"
                                                                               FontSize="11.5" Foreground="{DynamicResource TertiaryTextBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Card: Backup Files -->
                                    <Button Command="{Binding ActionCardCommand}"
                                            CommandParameter="Suggest a backup plan for my important files"
                                            Margin="6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CardBd"
                                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="14"
                                                                    Padding="18,16" MinHeight="82">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                        <TextBlock Text="💾" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Backup Files" FontSize="14" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="Protect your important documents &amp; photos"
                                                                               FontSize="11.5" Foreground="{DynamicResource TertiaryTextBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Quick command chips (returning users) -->
                        <ItemsControl ItemsSource="{Binding QuickCommands}" Margin="0,4,0,0"
                                      Visibility="{Binding ShowQuickSuggestions, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="{Binding}"
                                            Margin="4" Padding="14,8" FontSize="12"
                                            Command="{Binding DataContext.ApplyQuickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════ -->
                <!-- CHAT MESSAGES (card-style)         -->
                <!-- ══════════════════════════════════ -->
                <ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <!-- AI Message (card style) -->
                                <Border Padding="28,14,60,14" Margin="16,2,16,2"
                                        CornerRadius="16"
                                        Background="{DynamicResource CardBackgroundBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#6366F1" Offset="0"/>
                                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="Z" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="ZayFlow AI" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TimeText}" FontSize="10" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <controls:MarkdownViewer MarkdownText="{Binding Content}" Margin="38,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- User Message (right bubble) -->
                                <Border Padding="80,12,32,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel MaxWidth="800" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding TimeText}" FontSize="10" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="You" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border CornerRadius="16,4,16,16" Padding="16,12" HorizontalAlignment="Right"
                                                Background="{DynamicResource UserBubbleGradientBrush}">
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource OnAccentTextBrush}"
                                                       FontSize="14" LineHeight="22"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Typing Indicator (card style) -->
                <Border x:Name="TypingIndicatorBorder" Padding="28,10,60,10" Margin="16,2,16,2"
                        CornerRadius="16"
                        Background="{DynamicResource CardBackgroundBrush}"
                        Visibility="{Binding IsTyping, Converter={StaticResource BoolVis}}">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.35"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0.35"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.15">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.35"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0.35"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.3">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.35"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0.35"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1Shift" Storyboard.TargetProperty="Y">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-2.5"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2Shift" Storyboard.TargetProperty="Y" BeginTime="0:0:0.15">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-2.5"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3Shift" Storyboard.TargetProperty="Y" BeginTime="0:0:0.3">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-2.5"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel Orientation="Horizontal" MaxWidth="800" HorizontalAlignment="Left">
                        <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="Z" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="White"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" Opacity="0.35">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="Dot1Shift" Y="0"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" Opacity="0.35">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="Dot2Shift" Y="0"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Opacity="0.35">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="Dot3Shift" Y="0"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </StackPanel>
                        <TextBlock Text="  thinking..." FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════ -->
        <!--         PREMIUM INPUT AREA (BOTTOM)         -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="1" Padding="24,14,24,18" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerBrush}"
                Background="{DynamicResource WindowBackgroundBrush}">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center">

                <!-- Confirmation Banner with Action Preview -->
                <Border Visibility="{Binding ShowingConfirmation, Converter={StaticResource BoolVis}}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,0,12"
                        MaxHeight="320">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚠️" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Preview Before Action" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200" Margin="0,0,0,10">
                            <TextBlock Text="{Binding ConfirmationMessage}" TextWrapping="Wrap"
                                       FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}"
                                       LineHeight="19" FontFamily="Cascadia Code, Consolas, Courier New"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="✕ Cancel"
                                    Command="{Binding CancelCommand}" Padding="16,8" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="✓ Confirm &amp; Execute"
                                    Command="{Binding ExecuteCommand}" Padding="16,8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Upgrade Banner -->
                <Border Visibility="{Binding ShowUpgradeMessage, Converter={StaticResource BoolVis}}"
                        Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="12" Padding="12" Margin="0,0,0,8">
                    <TextBlock Text="{Binding UpgradeMessage}"
                               FontSize="12" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- ═══════════════════════════════════ -->
                <!-- UPGRADED INPUT BOX (bigger + glow)  -->
                <!-- ═══════════════════════════════════ -->
                <Border CornerRadius="18" Padding="5"
                        BorderThickness="1.5"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#6366F1" BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="False"
                                     MinHeight="48" MaxHeight="120"
                                     VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsInputEnabled}"
                                     KeyDown="InputBox_KeyDown"
                                     FontSize="14.5"
                                     Padding="16,12"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                                        <TextBlock Text="💡 Try: 'organize my downloads' or 'clean my PC'"
                                                                   FontSize="14" Foreground="{DynamicResource PlaceholderTextBrush}"
                                                                   Padding="16,12" VerticalAlignment="Center"
                                                                   IsHitTestVisible="False"
                                                                   Visibility="Collapsed" x:Name="PlaceholderText"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="{x:Null}">
                                                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- Clear Chat -->
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Content="{StaticResource IconTrash}" FontFamily="{StaticResource IconFont}" FontSize="16" Padding="10"
                                    ToolTip="Clear chat"
                                    Command="{Binding ClearChatCommand}"
                                    VerticalAlignment="Center"/>

                            <!-- Send Button -->
                            <Button Grid.Column="2"
                                    Command="{Binding SendCommand}"
                                    IsEnabled="{Binding IsInputEnabled}"
                                    Padding="14,10" Margin="4"
                                    Cursor="Hand" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="{StaticResource IconSend}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                                   Foreground="{DynamicResource OnAccentTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Border>

                <!-- Footer info -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TertiaryTextBrush}"
                               Text="{Binding EstimatedTokens, StringFormat='~{0} tokens'}" Margin="0,0,16,0"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TertiaryTextBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1} tokens used">
                                <Binding Path="UsedTokens"/>
                                <Binding Path="DailyTokenLimit"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
