<UserControl x:Class="ZayFlow.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Style="{StaticResource PremiumScrollViewer}" Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="800">

            <!-- Header -->
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="Settings" Style="{StaticResource HeadingXL}" Margin="0,0,0,6"/>
                <TextBlock Text="Customize your ZayFlow experience." Style="{StaticResource BodyText}"/>
            </StackPanel>

            <!-- ═══════════════════ GENERAL ═══════════════════ -->
            <TextBlock Text="General" Style="{StaticResource HeadingMD}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Start on boot -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start on system boot" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Launch ZayFlow automatically when you log in" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding StartOnBoot}"/>
                    </Grid>

                    <!-- Minimize to tray -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Minimize to system tray" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Keep ZayFlow running in the background" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding MinimizeToTray}"/>
                    </Grid>

                    <!-- Auto-update -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Auto-update" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Automatically download and install updates" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding AutoUpdate}"/>
                    </Grid>

                    <!-- Language -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Language" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Choose your preferred interface language" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource PremiumComboBox}"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════ APPEARANCE ═══════════════════ -->
            <TextBlock Text="Appearance" Style="{StaticResource HeadingMD}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Theme -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Select your preferred color scheme" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource PremiumComboBox}"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"/>
                    </Grid>

                    <!-- Accent Color -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Accent Color" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Choose your accent color (coming soon)" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding AccentColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="24" Height="24" CornerRadius="12" Margin="3"
                                            Background="{Binding}" Cursor="Hand"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Compact mode -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Compact mode" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Use smaller spacing and text sizes" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding CompactMode}"/>
                    </Grid>

                    <!-- Animations -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Animations" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Enable smooth transitions and effects" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding AnimationsEnabled}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════ AUTOMATION ═══════════════════ -->
            <TextBlock Text="Automation" Style="{StaticResource HeadingMD}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Default folder -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Default action folder" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Default directory for file operations" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource PremiumTextBox}"
                                 Text="{Binding DefaultActionFolder}"/>
                    </Grid>

                    <!-- Safe mode -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Safe mode" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Prevent risky operations on system folders" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding SafeMode}"/>
                    </Grid>

                    <!-- Confirmation -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Confirm before execute" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Always ask for confirmation before executing actions" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding ConfirmBeforeExecute}"/>
                    </Grid>

                    <!-- Grouping strategy -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Default grouping strategy" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="How to group files by default" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource PremiumComboBox}"
                                  ItemsSource="{Binding GroupingStrategies}"
                                  SelectedItem="{Binding DefaultGroupingStrategy}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════ AI & TOKENS ═══════════════════ -->
            <TextBlock Text="AI &amp; Tokens" Style="{StaticResource HeadingMD}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Groq API Key -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Groq API Key" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}">
                                <Run Text="Free AI (Llama 3.3 70B). Get key at:"/>
                                <Hyperlink NavigateUri="https://console.groq.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="console.groq.com"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource PremiumTextBox}"
                                 Text="{Binding GroqApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- Show tokens -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Show remaining tokens" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Display token counter in the UI" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding ShowRemainingTokens}"/>
                    </Grid>

                    <!-- Offline intelligence -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Enable offline intelligence" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Use local AI models for basic operations" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding EnableOfflineIntelligence}"/>
                    </Grid>

                    <!-- Token warning -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Token warning threshold" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Warn when tokens remaining fall below this number" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource PremiumTextBox}"
                                 Text="{Binding TokenWarningThreshold}"/>
                    </Grid>

                    <!-- Reset memory -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Reset local memory" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Clear all locally stored AI learning data" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Content="Reset" Command="{Binding ResetMemoryCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════ ACCOUNT ═══════════════════ -->
            <TextBlock Text="Account" Style="{StaticResource HeadingMD}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Email -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Email" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Your account email address" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource PremiumTextBox}"
                                 Text="{Binding UserEmail}" IsReadOnly="True"/>
                    </Grid>

                    <!-- License -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="License status" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LicenseStatus}" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BadgeFree}">
                            <TextBlock Text="FREE" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Upgrade -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Upgrade to Pro" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Unlock unlimited tokens and premium features" FontSize="12"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Content="Upgrade →" Command="{Binding UpgradeCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════ PRIVACY ═══════════════════ -->
            <TextBlock Text="Privacy" Style="{StaticResource HeadingMD}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="AI Privacy Mode" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Block sensitive prompts unless confirmed." FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PrivacyMode}"/>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Disable file upload" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Prevent any file content from being sent to AI." FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DisableFileUpload}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Require upload confirmation" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Always show warning before file analysis." FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RequireFileUploadConfirmation}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════ SYSTEM ═══════════════════ -->
            <TextBlock Text="System" Style="{StaticResource HeadingMD}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Refresh Logs" Command="{Binding RefreshLogsCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Clear Logs" Command="{Binding ClearLogsCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Clear Cache" Command="{Binding ClearCacheCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Reset Settings" Command="{Binding ResetSettingsCommand}"/>
                    </Grid>
                    <TextBox Style="{StaticResource PremiumTextBox}" Height="180" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding LogsText}" IsReadOnly="True"/>
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Button Style="{StaticResource PrimaryButton}" Content="Save Settings"
                    Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Padding="32,12"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
