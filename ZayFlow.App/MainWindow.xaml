<Window x:Class="ZayFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ZayFlow.App.ViewModels"
        xmlns:views="clr-namespace:ZayFlow.App.Views"
        xmlns:controls="clr-namespace:ZayFlow.App.Controls"
        xmlns:converters="clr-namespace:ZayFlow.App.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Width="1400" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="Manual"
        Title="ZayFlow AI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <converters:EqualityConverter x:Key="Eq"/>
        <converters:SidebarWidthConverter x:Key="SidebarWidth"/>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:BoolToCollapsedConverter x:Key="BoolCollapse"/>
    </Window.Resources>

    <!-- MAIN CONTAINER WITH ROUNDED CORNERS + GLASS -->
    <Border x:Name="MainBorder" CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.50" BlurRadius="28" ShadowDepth="0" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>  <!-- Custom Title Bar -->
                <RowDefinition Height="*"/>   <!-- Content Area -->
            </Grid.RowDefinitions>

            <!-- ═══ Ambient glow orbs (decorative depth) ═══ -->
            <Border Grid.RowSpan="2" CornerRadius="14" IsHitTestVisible="False">
                <Border.Background>
                    <DrawingBrush TileMode="None" Stretch="Fill">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <!-- Primary accent glow — top left -->
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,1"/>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Brush>
                                        <RadialGradientBrush Center="0.15,0.1" RadiusX="0.55" RadiusY="0.55">
                                            <GradientStop Color="#0F6366F1" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                                <!-- Secondary warm glow — bottom right -->
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,1"/>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Brush>
                                        <RadialGradientBrush Center="0.85,0.85" RadiusX="0.45" RadiusY="0.45">
                                            <GradientStop Color="#0A8B5CF6" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <!-- ═══ Subtle noise/grain texture (frosted glass feel) ═══ -->
            <Border Grid.RowSpan="2" CornerRadius="14" IsHitTestVisible="False" Opacity="0.03">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Stretch="None">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,1,1"/>
                                            <RectangleGeometry Rect="2,1,1,1"/>
                                            <RectangleGeometry Rect="1,3,1,1"/>
                                            <RectangleGeometry Rect="3,2,1,1"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!--             CUSTOM TITLE BAR                -->
            <!-- ═══════════════════════════════════════════ -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarGlassBrush}"
                    CornerRadius="14,14,0,0" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Name (clean, no hamburger) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" Margin="0,0,8,0" CornerRadius="8"
                                Background="{DynamicResource AccentGradientBrush}">
                            <TextBlock Text="Z" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="White"/>
                        </Border>
                        <TextBlock Text="ZayFlow" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>

                    <!-- Center (empty for drag) -->
                    <Grid Grid.Column="1"/>

                    <!-- Settings (clean, no token counter) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Style="{StaticResource GhostButton}" Content="{Binding ThemeIcon}" FontSize="14" Padding="8" FontFamily="{StaticResource IconFont}"
                                Command="{Binding ToggleThemeCommand}" Foreground="{DynamicResource IconPrimaryBrush}"/>
                        <Button Style="{StaticResource GhostButton}" Content="{StaticResource IconSettings}" FontSize="14" Padding="8" FontFamily="{StaticResource IconFont}"
                                Command="{Binding OpenSettingsCommand}" Foreground="{DynamicResource IconPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource GhostButton}" Click="MinimizeButton_Click"
                                Padding="14,0" Height="48" FontSize="18" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button x:Name="MaximizeBtn" Content="□" Style="{StaticResource GhostButton}" Click="MaximizeButton_Click"
                                Padding="14,0" Height="48" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="CloseButton_Click"
                                Padding="14,0" Height="48" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!--            CONTENT AREA (Sidebar + Page)    -->
            <!-- ═══════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding IsSidebarExpanded, Converter={StaticResource SidebarWidth}}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════ SIDEBAR — ChatGPT Style ═══════ -->
                <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarGlassBrush}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource GradientDividerBrush}"
                        CornerRadius="0,0,0,14"
                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Sidebar toggle + New Chat -->
                            <RowDefinition Height="*"/>     <!-- Chat History -->
                            <RowDefinition Height="Auto"/>  <!-- Account at bottom -->
                        </Grid.RowDefinitions>

                        <!-- ── Top: New Chat button + sidebar toggle ── -->
                        <DockPanel Grid.Row="0" Margin="8,12,8,4">
                            <!-- Sidebar collapse toggle (right side) -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6"
                                    Command="{Binding ToggleSidebarCommand}" ToolTip="Collapse sidebar" Cursor="Hand"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE89F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource TertiaryTextBrush}"/>
                            </Button>

                            <!-- New Chat button (left, fills remaining space) -->
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="8,8"
                                    Command="{Binding AIAssistantVM.NewChatCommand}" Cursor="Hand"
                                    ToolTip="New chat">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="New chat" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- ── Chat History List ── -->
                        <ScrollViewer Grid.Row="1" Style="{StaticResource PremiumScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="4,0">
                            <StackPanel Margin="4,4,4,8">
                                <TextBlock Text="Recent" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                           Margin="12,8,0,6"/>

                                <ItemsControl ItemsSource="{Binding AIAssistantVM.PastChats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,1" CornerRadius="8" Cursor="Hand" Padding="10,9"
                                                    MouseLeftButtonUp="ChatHistoryItem_Click" Tag="{Binding Id}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Chat title (truncated) -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="170"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>

                                                    <!-- 3-dot menu (visible on hover) -->
                                                    <ToggleButton x:Name="ChatMenuToggle" Grid.Column="1" Padding="4,2"
                                                            IsChecked="{Binding IsMenuOpen, Mode=TwoWay}"
                                                            VerticalAlignment="Center">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="MenuBtnBd" Background="Transparent" CornerRadius="6" Padding="4,2" Cursor="Hand">
                                                                    <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                               Foreground="{DynamicResource TertiaryTextBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="MenuBtnBd" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>

                                                    <!-- Dropdown menu (rename / delete) — Popup so it doesn't expand the row -->
                                                    <Popup Grid.Column="1" IsOpen="{Binding IsMenuOpen, Mode=TwoWay}" StaysOpen="False"
                                                           Placement="Bottom" PlacementTarget="{Binding ElementName=ChatMenuToggle}"
                                                           AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-80">
                                                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                CornerRadius="8" Padding="2" Margin="4">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
                                                            </Border.Effect>
                                                            <StackPanel MinWidth="120">
                                                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left" Padding="10,7"
                                                                        Command="{Binding DataContext.AIAssistantVM.RenameChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                                                                        <TextBlock Text="Rename" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left" Padding="10,7"
                                                                        Command="{Binding DataContext.AIAssistantVM.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                                                   Foreground="{DynamicResource ErrorBrush}" Margin="0,0,8,0"/>
                                                                        <TextBlock Text="Delete" FontSize="12" Foreground="{DynamicResource ErrorBrush}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ── Bottom: Account section (like ChatGPT) ── -->
                        <Border Grid.Row="2" Padding="8,10" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource DividerBrush}">
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="8,8"
                                    Command="{Binding NavigateCommand}" CommandParameter="Account"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            Background="{DynamicResource AccentSubtleBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="Account" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════ Collapsed sidebar — toggle + new chat buttons ═══════ -->
                <Border Grid.Column="0" Width="48" HorizontalAlignment="Left"
                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolCollapse}}">
                    <StackPanel VerticalAlignment="Top" Margin="4,12,4,0">
                        <Button Style="{StaticResource GhostButton}" Padding="8"
                                Command="{Binding ToggleSidebarCommand}" ToolTip="Open sidebar">
                            <TextBlock Text="&#xE89F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{DynamicResource IconPrimaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="8" Margin="0,4,0,0"
                                Command="{Binding AIAssistantVM.NewChatCommand}" ToolTip="New chat">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ═══════ PAGE CONTENT ═══════ -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <ContentControl Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                        </ContentControl.RenderTransform>
                        <ContentControl.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                            From="0,12,0,0" To="0" Duration="0:0:0.3">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.985" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.985" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ContentControl.Triggers>
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                                <views:DashboardView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:AutomationViewModel}">
                                <views:AutomationView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:AIAssistantViewModel}">
                                <views:AIAssistantView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
                                <views:HistoryView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:FileIntelligenceViewModel}">
                                <views:FileIntelligenceView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:NotesViewModel}">
                                <views:NotesView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ProductivityToolsViewModel}">
                                <views:ProductivityToolsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:InsightsViewModel}">
                                <views:InsightsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                                <views:SettingsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:AccountViewModel}">
                                <views:AccountView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DownloadsViewModel}">
                                <views:DownloadsView/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>

                    <!-- ═══════ TOAST NOTIFICATIONS ═══════ -->
                    <ItemsControl ItemsSource="{Binding Notifications}"
                                  VerticalAlignment="Top" HorizontalAlignment="Right"
                                  Margin="0,70,20,0" IsHitTestVisible="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ToastNotification/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
