<Window x:Class="ZayFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ZayFlow.App.ViewModels"
        xmlns:views="clr-namespace:ZayFlow.App.Views"
        xmlns:controls="clr-namespace:ZayFlow.App.Controls"
        xmlns:converters="clr-namespace:ZayFlow.App.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Width="1400" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="Manual"
        Title="ZayFlow AI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <converters:EqualityConverter x:Key="Eq"/>
        <converters:SidebarWidthConverter x:Key="SidebarWidth"/>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:BoolToCollapsedConverter x:Key="BoolCollapse"/>
    </Window.Resources>

    <!-- MAIN CONTAINER WITH ROUNDED CORNERS + GLASS -->
    <Border x:Name="MainBorder" CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.50" BlurRadius="28" ShadowDepth="0" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>  <!-- Custom Title Bar -->
                <RowDefinition Height="*"/>   <!-- Content Area -->
            </Grid.RowDefinitions>

            <!-- ═══ Ambient glow orbs (decorative depth) ═══ -->
            <Border Grid.RowSpan="2" CornerRadius="14" IsHitTestVisible="False">
                <Border.Background>
                    <DrawingBrush TileMode="None" Stretch="Fill">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <!-- Primary accent glow — top left -->
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,1"/>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Brush>
                                        <RadialGradientBrush Center="0.15,0.1" RadiusX="0.55" RadiusY="0.55">
                                            <GradientStop Color="#0F6366F1" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                                <!-- Secondary warm glow — bottom right -->
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,1"/>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Brush>
                                        <RadialGradientBrush Center="0.85,0.85" RadiusX="0.45" RadiusY="0.45">
                                            <GradientStop Color="#0A8B5CF6" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <!-- ═══ Subtle noise/grain texture (frosted glass feel) ═══ -->
            <Border Grid.RowSpan="2" CornerRadius="14" IsHitTestVisible="False" Opacity="0.03">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Stretch="None">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,1,1"/>
                                            <RectangleGeometry Rect="2,1,1,1"/>
                                            <RectangleGeometry Rect="1,3,1,1"/>
                                            <RectangleGeometry Rect="3,2,1,1"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!--             CUSTOM TITLE BAR                -->
            <!-- ═══════════════════════════════════════════ -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarGlassBrush}"
                    CornerRadius="14,14,0,0" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="Z" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6366F1" Offset="0"/>
                                        <GradientStop Color="#A5B4FC" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="ZayFlow" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>

                        <!-- User Plan Badge -->
                        <Border Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BadgeFree}">
                            <TextBlock Text="{Binding UserPlan}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Center (empty for drag) -->
                    <Grid Grid.Column="1"/>

                    <!-- Token Counter & Settings -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="10,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconChart}" Style="{StaticResource FluentIcon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TokenText}" FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource GhostButton}" Content="{Binding ThemeIcon}" FontSize="14" Padding="8" FontFamily="{StaticResource IconFont}"
                                Command="{Binding ToggleThemeCommand}" Foreground="{DynamicResource IconPrimaryBrush}"/>
                        <Button Style="{StaticResource GhostButton}" Content="{StaticResource IconSettings}" FontSize="14" Padding="8" FontFamily="{StaticResource IconFont}"
                                Command="{Binding OpenSettingsCommand}" Foreground="{DynamicResource IconPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource GhostButton}" Click="MinimizeButton_Click"
                                Padding="14,0" Height="48" FontSize="18" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button x:Name="MaximizeBtn" Content="□" Style="{StaticResource GhostButton}" Click="MaximizeButton_Click"
                                Padding="14,0" Height="48" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="CloseButton_Click"
                                Padding="14,0" Height="48" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!--            CONTENT AREA (Sidebar + Page)    -->
            <!-- ═══════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding IsSidebarExpanded, Converter={StaticResource SidebarWidth}}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════ SIDEBAR NAVIGATION ═══════ -->
                <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarGlassBrush}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource GradientDividerBrush}"
                        CornerRadius="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Navigation Items -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="8,12">
                            <ItemsControl ItemsSource="{Binding NavigationItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" CornerRadius="8" Cursor="Hand"
                                                MouseLeftButtonUp="NavItem_Click" Tag="{Binding Key}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.015" Duration="0:0:0.14"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.015" Duration="0:0:0.14"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1" Duration="0:0:0.12"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1" Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SidebarItemActiveBrush}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <!-- Active left accent bar -->
                                                <Border HorizontalAlignment="Left" Width="3" CornerRadius="0,3,3,0" Margin="0,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="14,10">
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" Margin="0,0,12,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource IconPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                           Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SidebarItemActiveTextBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Collapse Button -->
                        <Border Grid.Row="1" Padding="8,12" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource DividerBrush}">
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                    Command="{Binding ToggleSidebarCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◀" FontSize="14" Foreground="{DynamicResource IconPrimaryBrush}"/>
                                    <TextBlock Text="  Collapse" FontSize="12" Margin="8,0,0,0"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════ PAGE CONTENT ═══════ -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <ContentControl Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                        </ContentControl.RenderTransform>
                        <ContentControl.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                            From="0,12,0,0" To="0" Duration="0:0:0.3">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.985" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.985" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ContentControl.Triggers>
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                                <views:DashboardView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:AutomationViewModel}">
                                <views:AutomationView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:AIAssistantViewModel}">
                                <views:AIAssistantView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
                                <views:HistoryView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:FileIntelligenceViewModel}">
                                <views:FileIntelligenceView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:NotesViewModel}">
                                <views:NotesView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ProductivityToolsViewModel}">
                                <views:ProductivityToolsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:InsightsViewModel}">
                                <views:InsightsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                                <views:SettingsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:AccountViewModel}">
                                <views:AccountView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DownloadsViewModel}">
                                <views:DownloadsView/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>

                    <!-- ═══════ TOAST NOTIFICATIONS ═══════ -->
                    <ItemsControl ItemsSource="{Binding Notifications}"
                                  VerticalAlignment="Top" HorizontalAlignment="Right"
                                  Margin="0,70,20,0" IsHitTestVisible="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ToastNotification/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
